# Application
APP_NAME=FundOps Agent Studio
APP_ENV=development
LOG_LEVEL=INFO

# API
API_HOST=0.0.0.0
API_PORT=8000

# Database
# PostgreSQL example:
DATABASE_URL=postgresql+psycopg://fundops:fundops@localhost:5432/fundops
# MySQL / shared Cherry infrastructure example (use a separate FundOps database/schema):
# DATABASE_URL=mysql+pymysql://fundops:password@mysql-host:3306/fundops_agent

# LLM provider - optional; never commit real credentials
LLM_PROVIDER=openai
LLM_MODEL=
LLM_API_KEY=
