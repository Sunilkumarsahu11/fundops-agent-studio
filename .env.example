# Application
APP_NAME=FundOps Agent Studio
APP_ENV=development
LOG_LEVEL=INFO

# API
API_HOST=0.0.0.0
API_PORT=8000

# Unified Cherry MySQL database
# FundOps uses namespaced fundops_* tables inside the same database.
DATABASE_URL=mysql+pymysql://fundops:fundops@localhost:3306/cherrybank?charset=utf8mb4

# LLM provider - optional; never commit real credentials
LLM_PROVIDER=openai
LLM_MODEL=
LLM_API_KEY=
